SPACEBYTE_BASE_URL=https://spacebyte.in/api/v1
SPACEBYTE_TOKEN=your_spacebyte_token_here
SPACEBYTE_AUTH_SCHEME=Bearer
SPACEBYTE_ALLOW_INSECURE_TLS=false
ADMIN_TOKEN=change_me_to_a_strong_random_value

# Strong random string used to sign gallery access cookies.
# If left empty a random value is generated on boot and every restart logs viewers out.
SESSION_SECRET=

# Set this to /gallery when the app is mounted at https://your-domain/gallery/
APP_BASE_PATH=/gallery

# Must match the Port shown in the MilesWeb Node.js "Proxy" section.
# The app binds to 0.0.0.0 on this port. Defaults to 3001 if left unset.
PORT=3001

# Optional tuning -------------------------------------------------------------

# Where cached thumbnails and gallery indexes are written.
DATA_DIR=./data

# Longest edge (px) of the cached grid thumbnail. 320-480 is a good range.
THUMBNAIL_SIZE=400

# Longest edge (px) of the lightbox preview, cached lazily on first view.
PREVIEW_SIZE=1600

# Parallel image downloads/resizes during a background sync. Keep low: each one
# downloads a full-resolution original and resizes it with sharp.
SYNC_CONCURRENCY=2

# Re-scan every event this often to pick up newly uploaded photos. 0 disables it.
SYNC_REFRESH_MINUTES=360

# "Download all" is split into parts so a single request stays bounded.
ZIP_PART_MAX_FILES=400
ZIP_PART_MAX_BYTES=1610612736

# How long a viewer stays signed in.
SESSION_TTL_HOURS=12
