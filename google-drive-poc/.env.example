# Copy this file to .env. Never commit the real service-account JSON.
PORT=3002
ADMIN_TOKEN=change_me_to_a_strong_random_value
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# Local corporate TLS proxy workaround only. Prefer installing the proxy CA instead.
GOOGLE_DRIVE_ALLOW_INSECURE_TLS=false