# Copy these into the MilesWeb "Setup Node.js App" environment variable screen.
# Do NOT upload a real .env file to the server.

# Application is published under https://YOUR-DOMAIN/gallery
APP_BASE_PATH=/gallery

# Must match the Port shown in the MilesWeb Node.js "Proxy" section.
# The app binds to 0.0.0.0 on this port. Defaults to 3001 if left unset.
PORT=3001

# Google Drive service account (share the Starz Shots root folder with client_email).
# Use ONE of the two variables below. The base64 form is easier to paste into mPanel.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Google Drive folder ID of the "Starz Shots" root folder.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Strong random string. Required to open /gallery/admin.
ADMIN_TOKEN=

# Strong random string used to sign gallery access cookies.
# If left empty a random value is generated on boot and every restart logs viewers out.
SESSION_SECRET=

# Optional tuning -------------------------------------------------------------

# Where cached thumbnails and gallery indexes are written.
DATA_DIR=./data

# Longest edge (px) of the cached grid thumbnail. 320-480 is a good range.
THUMBNAIL_SIZE=400

# Longest edge (px) of the lightbox preview, cached lazily on first view.
PREVIEW_SIZE=1600

# Parallel thumbnail downloads during a background sync. Keep low on shared hosting.
SYNC_CONCURRENCY=4

# Re-scan every event this often to pick up newly uploaded photos. 0 disables it.
SYNC_REFRESH_MINUTES=360

# "Download all" is split into parts so a single request stays bounded.
ZIP_PART_MAX_FILES=400
ZIP_PART_MAX_BYTES=1610612736

# How long a viewer stays signed in.
SESSION_TTL_HOURS=12

# Only enable if MilesWeb egress is behind a TLS-inspecting proxy.
GOOGLE_DRIVE_ALLOW_INSECURE_TLS=false
